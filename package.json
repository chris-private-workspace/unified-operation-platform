{
  "name": "unified-operation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Operation Platform — monorepo (apps/api NestJS + apps/web React). See docs/architecture.md.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:dev": "npm run start:dev -w @uop/api",
    "build": "npm run build -w @uop/api -w @uop/web",
    "lint": "npm run lint -w @uop/api -w @uop/web",
    "test": "npm run test -w @uop/api -w @uop/web",
    "prisma:generate": "npm run prisma:generate -w @uop/api",
    "prisma:migrate": "npm run prisma:migrate -w @uop/api",
    "seed": "npm run seed -w @uop/api"
  }
}
