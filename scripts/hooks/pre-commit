#!/bin/sh
# pre-commit hook — lint staged TypeScript 檔(快)。
# 啟用一次: git config core.hooksPath scripts/hooks
# 緊急跳過: git commit --no-verify
set -e

# 只揀 staged 嘅 .ts / .tsx:
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
[ -z "$STAGED" ] && exit 0

echo "[pre-commit] eslint on staged files..."
npx eslint $STAGED || { echo "[pre-commit] FAILED — 修好先 commit (急可 --no-verify)"; exit 1; }

echo "[pre-commit] lint OK"
