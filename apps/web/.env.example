# apps/web — env 範本(Vite)。Copy 做 .env / .env.local 填實際值。
# .env* 已 gitignore,唔 commit(CLAUDE.md §4.4 / §5 H4)。
# ⚠️ 只有 VITE_ 前綴變數會 bundle 入前端 → 絕不放 secret(SPA PKCE 本身無 client secret)。

# ── 本地開發 dev-bypass(pairs with backend AUTH_DEV_BYPASS) ──
# true → 跳 login gate + 唔 attach Bearer(配後端 bypass),本地零登入照跑。
# prod build 一律唔設 / false(對應 RISK R2)。
VITE_AUTH_DEV_BYPASS=true

# ── API base(dev 由 vite proxy /api → NestJS;跨 origin 才需覆寫) ──
# VITE_API_BASE_URL=/api

# ── Entra SSO(AUTH-2b — IT SPA app registration ready 後填) ───────
# 值來源 = W10-auth-fe-sso/AUTH-2b-RUNBOOK.md 的 IT app-reg handoff。
# 全部非 secret(client/tenant id 係公開識別碼;SPA 無 client secret)。
# 填齊且 VITE_AUTH_DEV_BYPASS 非 true → msalConfigured=true → 啟真 SSO flow。
#
# uop-web SPA app registration 的 Application (client) ID:
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Tenant (directory) ID → authority https://login.microsoftonline.com/<tenant-id>:
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# API scope — audience 必對齊後端 ENTRA_API_AUDIENCE(ADR-0002):
# 格式 api://<uop-api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# SPA redirect URI — 必與 app registration 登記值逐字相同(dev = http://localhost:5173):
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
