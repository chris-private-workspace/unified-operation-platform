# uop-web nginx — serves the SPA and reverse-proxies /api/* to the api container
# so the browser sees ONE origin (ADR-0012). ${API_UPSTREAM} is rendered from the
# env var at container start (e.g. http://uop-api:3000 on a local docker network,
# or the ACA internal FQDN of the api app). nginx's $uri/$host are left intact.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Do not cache index.html — it references hashed asset filenames that change
    # each deploy; a stale index would point at assets that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Hashed static assets are immutable — cache hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA client-side routing: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin API proxy. The trailing slash on both the location and
    # proxy_pass strips the /api prefix (API routes have no such prefix) —
    # mirrors the vite dev proxy rewrite. credentials:'include' cookies ride
    # through unchanged because this stays same-origin to the browser.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Host MUST be the upstream host (the api container app), not the browser's
        # host: Azure Container Apps routes internal ingress by Host, so forwarding
        # the public web FQDN makes the api ingress return its "app does not exist"
        # 404. $proxy_host = the host from proxy_pass (e.g. ca-uop-api).
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
