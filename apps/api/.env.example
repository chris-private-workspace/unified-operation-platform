# Unified Operation Platform — env 範本
# Copy 做 .env 填實際值。.env 已 gitignore,絕不 commit 真實 secret(見 CLAUDE.md §5 H4)。

# ── Microsoft Graph (app-only / client credentials) ──────────
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# ── ServiceNow (Table API, basic-auth integration account) ───
SERVICENOW_INSTANCE_URL=https://ricoh.service-now.com
SERVICENOW_USER=svc-platform-integration
SERVICENOW_PASSWORD=your-password
# Align with the table Phase 1 already uses:
SERVICENOW_DEFAULT_TABLE=sc_req_item

# ── Database (Prisma) ────────────────────────────────────────
# 對齊 repo root docker-compose.yml(postgres user/pass/db = uop/uop/platform;host port 5433 避開既有 5432)
DATABASE_URL=postgresql://uop:uop@localhost:5433/platform

# ── n8n inbound intake (m2m, ADR-0008 Phase 甲) ──────────────
# Shared secret n8n sends as the X-Intake-Key header on POST /requests/intake.
# Fail-closed: unset → app boot fails (IntakeKeyGuard getOrThrow). Rotate per env.
INTAKE_API_KEY=change-me-intake-secret

# ── Outbound request submission (ADR-0008 Phase 丙, W26) ──────
# Which provider POST /requests uses to create the ServiceNow ticket:
#   n8n  → N8nWorkflowProvider (platform → n8n webhook)
#   else → DirectServiceNowProvider (platform → ServiceNow Table API); DEFAULT.
REQUEST_SUBMISSION_PROVIDER=direct
# n8n outbound webhook — only required when REQUEST_SUBMISSION_PROVIDER=n8n
# (then getOrThrow fails boot if unset). Platform sends the key as X-N8n-Key.
# Representative (CONTRACT-OUTBOUND); align real URL/key with the n8n owner.
N8N_OUTBOUND_WEBHOOK_URL=https://n8n.example.com/webhook/create-license-request
N8N_OUTBOUND_WEBHOOK_KEY=change-me-n8n-outbound-secret

# ── Phase 1 sync sweep (ADR-0015, W37) ───────────────────────
# 排程向 Graph findUser 證實仲未過 gate 嘅 request,命中即開 gate。
# 全部有 default,唔設都跑得(get 而唔係 getOrThrow)。
#
# 總開關。**只有明文 'false' 先會停** —— 唔設 / 打錯字 = 繼續跑。
# Graph 出事嘅營運急救手段就係呢個(排程間隔本身寫死 10 分鐘,見 ADR-0015 D5 偏離)。
SYNC_SWEEP_ENABLED=true
# 每輪最多查幾多張(default 50)。
SYNC_SWEEP_BATCH=50
# 幾多日之後放棄(default 30)。防殭屍單:UPN 打錯 / 帳號已刪嘅單永遠 sync 唔到,
# 冇 cutoff 就會世世代代佔住 batch,而 batch 係舊→新排序,新單反而餓死。
SYNC_SWEEP_MAX_AGE_DAYS=30

# ── Email / Azure Communication Services (CH-011, ADR-0019) ───
# 完全 OPTIONAL:兩個都唔設,平台照常 boot 同運作,只係 email 功能唔開放
# (D4 —— 刻意唔用 getOrThrow,一個可選功能配置錯唔應該令成個平台起唔到)。
#
# 🔴 SECRET。整條字串內含 accesskey,等同「用本機構身份寄信」嘅權限。
# env-only:永遠唔會入 DB / API 回應 / audit / log(ADR-0013 D2/D5, H4)。
# 格式:endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_CONNECTION_STRING=endpoint=https://REPLACE.communication.azure.com/;accesskey=REPLACE_ME
# 寄件地址。非機密,ADMIN 可以喺 Settings › Integrations 改(DB 覆蓋 env)。
# ⚠️ 必須係 ACS 上面已驗證嘅 sender domain,否則 ACS 會收貨但唔送達,
# 而 API 仍然返 Succeeded(CH-011 R1)—— 呢個 connector 冇 probe,所以第一次
# 真寄係唯一證據。
ACS_SENDER_ADDRESS=UnifiedOperationsPortal@rci-t.com

# ── 平台對外網址 (W41 / AUTH-4c-C) ────────────────────────────
# 用戶打得開嘅平台網址,用嚟砌密碼重設連結:
#   <APP_BASE_URL>/reset-password#token=<單次 token>
# (token 放 fragment 而唔係 query,咁佢就唔會入前面 nginx 嘅 access log —— plan OQ-4)
#
# OPTIONAL,用 `get` 唔用 `getOrThrow`,同上面 ACS 同一個理由:一個可選功能
# 配置錯,唔應該令成個平台起唔到身(ADR-0019 D4;BUG-008 啱啱先示範咗代價)。
#
# ⚠️ 但唔設嘅後果係**靜默**嘅:`POST /auth/forgot-password` 照返 204(統一回應,
# 唔可以因為配置錯而變成一個可以用嚟枚舉帳號嘅訊號),用戶就係永遠等唔到封信,
# 唯一線索係 api log 一行 error。凡開放本地登入嘅環境都應該設。
#
# 未設嗰陣**唔會**建 token、**唔會**寫 audit、**唔會**燒用戶個 5 分鐘 cooldown ——
# controller 刻意喺 `issue()` 之前先檢查。原因:寫落 audit 嗰行會係 `reason: 'issued'`
# 而信一封都冇寄,即係 audit 會答錯「為咩我個用戶收唔到信」,而 ADR-0009 令佢成為
# 營運唯一應該信嘅地方。配置錯屬 ops(睇 log / 監控),唔屬業務 audit trail。
#
# 有冇 trailing slash 都得(會自動 trim)。
APP_BASE_URL=http://localhost:5173
