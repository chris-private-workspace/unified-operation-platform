# Unified Operation Platform — env 範本
# Copy 做 .env 填實際值。.env 已 gitignore,絕不 commit 真實 secret(見 CLAUDE.md §5 H4)。

# ── Microsoft Graph (app-only / client credentials) ──────────
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# ── ServiceNow (Table API, basic-auth integration account) ───
SERVICENOW_INSTANCE_URL=https://ricoh.service-now.com
SERVICENOW_USER=svc-platform-integration
SERVICENOW_PASSWORD=your-password
# Align with the table Phase 1 already uses:
SERVICENOW_DEFAULT_TABLE=sc_req_item

# ── ServiceNow Service Catalog (ADR-0025 D2 / BUG-010) ───────
# 平台開單走 catalog API,唔走 Table API insert —— `POST /api/now/table/sc_request`
# 對 integration 帳號係 403,連只有一個 field 嘅 payload 都擋(table-level ACL,
# 而同一帳號 PATCH sc_req_item 得 200)。catalog route 亦順帶令 SN 自己行 workflow,
# 出嚟嘅 REQ/RITM/catalog task 同真單同一形狀。
# 兩個 sys_id 都係 instance-specific,喺 `sc_cat_item` 搵(下面係 ricohapdev 實測值)。
SERVICENOW_O365_CATALOG_ITEM_SYS_ID=efe38adedbef6f80a98e75868c961936
SERVICENOW_D365_CATALOG_ITEM_SYS_ID=fe92525547e416101a2b581fe16d431a
# 🔴 邊啲 SKU 當 D365(逗號分隔嘅 part number 前綴,大小寫不敏感)。
# `SkuCatalog.category` 答唔到呢條問題:實測佢嘅值係 Base / Add-on /
# Power Platform / Voice(licence 角色分類),而 30 個 Dynamics SKU 全部冇 category。
# 所以只可以睇 part number —— 呢個係 heuristic,失效模式係開錯一張真單,
# 所以整成 env 可改而唔使 deploy。留空 = 用內置 D365,DYN365,Dynamics。
SERVICENOW_D365_SKU_PREFIXES=

# ── Database (Prisma) ────────────────────────────────────────
# 對齊 repo root docker-compose.yml(postgres user/pass/db = uop/uop/platform;host port 5433 避開既有 5432)
DATABASE_URL=postgresql://uop:uop@localhost:5433/platform

# ── n8n inbound intake (m2m, ADR-0008 Phase 甲) ──────────────
# Shared secret n8n sends as the X-Intake-Key header on POST /requests/intake.
# Fail-closed: unset → app boot fails (IntakeKeyGuard getOrThrow). Rotate per env.
INTAKE_API_KEY=change-me-intake-secret

# ── Outbound request submission (ADR-0008 Phase 丙, W26) ──────
# Which provider POST /requests uses to create the ServiceNow ticket:
#   n8n  → N8nWorkflowProvider (platform → n8n webhook)
#   else → DirectServiceNowProvider (platform → ServiceNow Table API); DEFAULT.
REQUEST_SUBMISSION_PROVIDER=direct
# n8n outbound webhook — only required when REQUEST_SUBMISSION_PROVIDER=n8n
# (then getOrThrow fails boot if unset). Platform sends the key as X-N8n-Key.
# Representative (CONTRACT-OUTBOUND); align real URL/key with the n8n owner.
N8N_OUTBOUND_WEBHOOK_URL=https://n8n.example.com/webhook/create-license-request
N8N_OUTBOUND_WEBHOOK_KEY=change-me-n8n-outbound-secret

# ── Phase 1 sync sweep (ADR-0015, W37) ───────────────────────
# 排程向 Graph findUser 證實仲未過 gate 嘅 request,命中即開 gate。
# 全部有 default,唔設都跑得(get 而唔係 getOrThrow)。
#
# 總開關。**只有明文 'false' 先會停** —— 唔設 / 打錯字 = 繼續跑。
# Graph 出事嘅營運急救手段就係呢個(排程間隔本身寫死 10 分鐘,見 ADR-0015 D5 偏離)。
SYNC_SWEEP_ENABLED=true
# 每輪最多查幾多張(default 50)。
SYNC_SWEEP_BATCH=50
# 幾多日之後放棄(default 30)。防殭屍單:UPN 打錯 / 帳號已刪嘅單永遠 sync 唔到,
# 冇 cutoff 就會世世代代佔住 batch,而 batch 係舊→新排序,新單反而餓死。
SYNC_SWEEP_MAX_AGE_DAYS=30

# ── Email / Azure Communication Services (CH-011, ADR-0019) ───
# 完全 OPTIONAL:兩個都唔設,平台照常 boot 同運作,只係 email 功能唔開放
# (D4 —— 刻意唔用 getOrThrow,一個可選功能配置錯唔應該令成個平台起唔到)。
#
# 🔴 SECRET。整條字串內含 accesskey,等同「用本機構身份寄信」嘅權限。
# env-only:永遠唔會入 DB / API 回應 / audit / log(ADR-0013 D2/D5, H4)。
# 格式:endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_CONNECTION_STRING=endpoint=https://REPLACE.communication.azure.com/;accesskey=REPLACE_ME
# 寄件地址。非機密,ADMIN 可以喺 Settings › Integrations 改(DB 覆蓋 env)。
# ⚠️ 必須係 ACS 上面已驗證嘅 sender domain,否則 ACS 會收貨但唔送達,
# 而 API 仍然返 Succeeded(CH-011 R1)—— 呢個 connector 冇 probe,所以第一次
# 真寄係唯一證據。
ACS_SENDER_ADDRESS=UnifiedOperationsPortal@rci-t.com

# ── 平台對外網址 (W41 / AUTH-4c-C) ────────────────────────────
# 用戶打得開嘅平台網址,用嚟砌密碼重設連結:
#   <APP_BASE_URL>/reset-password#token=<單次 token>
# (token 放 fragment 而唔係 query,咁佢就唔會入前面 nginx 嘅 access log —— plan OQ-4)
#
# OPTIONAL,用 `get` 唔用 `getOrThrow`,同上面 ACS 同一個理由:一個可選功能
# 配置錯,唔應該令成個平台起唔到身(ADR-0019 D4;BUG-008 啱啱先示範咗代價)。
#
# ⚠️ 但唔設嘅後果係**靜默**嘅:`POST /auth/forgot-password` 照返 204(統一回應,
# 唔可以因為配置錯而變成一個可以用嚟枚舉帳號嘅訊號),用戶就係永遠等唔到封信,
# 唯一線索係 api log 一行 error。凡開放本地登入嘅環境都應該設。
#
# 未設嗰陣**唔會**建 token、**唔會**寫 audit、**唔會**燒用戶個 5 分鐘 cooldown ——
# controller 刻意喺 `issue()` 之前先檢查。原因:寫落 audit 嗰行會係 `reason: 'issued'`
# 而信一封都冇寄,即係 audit 會答錯「為咩我個用戶收唔到信」,而 ADR-0009 令佢成為
# 營運唯一應該信嘅地方。配置錯屬 ops(睇 log / 監控),唔屬業務 audit trail。
#
# 有冇 trailing slash 都得(會自動 trim)。
APP_BASE_URL=http://localhost:5173

# ── Onboarding intake 通知 (CH-021) ───────────────────────────
# 一張 onboarding request 由 n8n 入到平台之後,平台會通知**兩邊**(Chris
# 2026-08-09 拍板「兩者都要」):
#   ① 該 OpCo 嘅 active OPCO_IT 用戶 —— 佢哋係真正會去處理嗰班人
#   ② 下面呢個固定 ops 信箱      —— 佢係「邊個 OpCo 一個 IT 都冇配」嘅安全網
#
# OPTIONAL,同 APP_BASE_URL 一樣用 `get` 唔用 `getOrThrow`。
#
# ⚠️ 唔設嘅後果:少一個收件人。**若果該 OpCo 亦都冇 active OPCO_IT 用戶,
# 咁就一封都唔會寄** —— 呢個唔會令 intake 失敗(CH-021 D3:request 照建),
# 但 api log 會有一行 warn。24 個 OpCo 入面 seed 只有 RHK 有 OPCO_IT 用戶,
# 所以喺未配好 user 嘅環境,呢個 key 實際上就係唯一收件人。
#
# 唔係 secret(一個內部信箱地址),但**唔好**喺呢度填真地址 —— 佔位就夠。
OPS_NOTIFICATION_MAILBOX=

# ── 認證 (ADR-0005 dual-provider / ADR-0028 SSO) ───────────────────
# 平台有兩條登入路,兩條都發**同一個** httpOnly session cookie:
#   ① Entra SSO      —— 下面 ENTRA_* 四個(ADR-0028)
#   ② break-glass    —— 本地帳號密碼,靠 AUTH_JWT_SECRET
# 至少要有一條,否則 api boot 直接 fail(JwtAuthGuard 建構時擋)。
#
# 🔴 SECRET。簽平台 session token 用(HS256)。生法:`openssl rand -hex 32`。
# 換咗佢 = 所有人即刻被登出(舊 token 驗唔過)。
AUTH_JWT_SECRET=change-me-64-hex-chars
#
# ── Entra SSO(server-side authorization code exchange, ADR-0028) ──
# 四個**全部**要有先至會 enable;缺一個 = `GET /auth/sso/status` 返
# `{enabled:false}`,前端個掣就會暗住(唔會出現「撳到但最後一步先死」)。
#
# 🔴 呢四個係 **API runtime** 讀,唔係前端 build-time。
#    ⇒ 改任何一個 = 改 env + restart container,**唔使重 build web image**。
#    (ADR-0003 舊設計係 VITE_* 烘死落 bundle,改一個 client id 都要重 build。)
#
# Directory (tenant) ID:
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID —— 亦即 id_token 個 `aud`,唔需要 Application ID URI:
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 🔴 SECRET。client secret,永遠只喺 server 側用,絕不入 bundle / log / audit。
# ⚠️ 有到期日 —— 過期當日 SSO 會靜靜死,break-glass 仍然入得到(RISK R8)。
ENTRA_CLIENT_SECRET=your-client-secret
# 必須同 app registration 登記嗰個**逐字**一樣(連 trailing slash 都計):
ENTRA_REDIRECT_URI=http://localhost:5173
#
# ── Entra Bearer(ADR-0002,選用) ────────────────────────────────
# guard 仲收 `Authorization: Bearer <entra access token>`,畀 machine-to-machine
# 用。ADR-0028 冇拆走佢(有 test、零成本)。瀏覽器登入唔行呢條路,所以呢個
# 唔設都完全冇影響。設咗就要同 ENTRA_TENANT_ID 一齊有先生效。
# ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
#
# ── 本地開發 dev-bypass ───────────────────────────────────────────
# 'true' → 完全跳過驗證,每個 request 都當 seed ADMIN 跑。**永遠唔好落 prod**
# (ADR-0002 risk R-C / RISK R2)。配前端 VITE_AUTH_DEV_BYPASS。
# AUTH_DEV_BYPASS=true
# 選用:指定 bypass 行邊個 seed user(唔設 = seed ADMIN),用嚟本地試 OpCo scope。
# AUTH_DEV_USER_EMAIL=opco.it.rhk@rapo.com.hk

# ── AI agent runtime (W46 / ADR-0036) ─────────────────────────────
#
# 🔴🔴 呢個一定要係 1,而且佢係 D11「三重關」嘅第一關。
#
# `@openai/agents` **預設開住 tracing**,而 trace 內容包括 **tool call** ——
# 我哋個 `get_request` 回傳緊 target UPN。即係話:呢個 library 嘅預設行為
# 就係**把 PII 送去第三方**,而忘記關佢**唔會有任何錯誤、warning 或者 log**。
#
# 另外兩關:`openai-agents.provider.ts` 起身嗰陣喺 code 側再關一次
# (`enforceTracingDisabled()`),同埋一條 test 鎖死佢。三關都係為咗同一件事:
# 呢度冇任何嘢會喺出事嗰陣變紅,所以唔可以靠記得。
#
# ⚠️ 將來如果真係想要 trace,唯一可接受嘅路係 **self-hosted trace processor**,
# 唔係「開返 OpenAI 嗰個但少送啲嘢」。
OPENAI_AGENTS_DISABLE_TRACING=1
#
# 揀邊個 runtime(seam ⑤)。ADR-0013 C2:boot 讀一次,改咗要重啟。
#
# 🔄 W46 期二 G4 起,'claude-tool-runner' **實作咗**,配佢就真係行佢,唔再
# fall back。一個**認唔到**嘅值(例如打錯字)仍然會 fall back 去
# openai-agents 兼 log 一行 warn,而 Integrations panel 顯示「配置咗 X、
# 跑緊 Y」(BUG-011 個 SeamRuntimeRegistry)。
#
# 🔴 但「揀到佢」唔等於「行得到佢」:冇 ANTHROPIC_API_KEY 就 503(ADR-0038
# D3),因為 **OQ-7 嘅 Claude 半邊從來未答過**(ADR-0037 E7)。呢個係刻意
# 唔靜靜跌返去 OpenAI —— 平台唔可以用「喺第二度行咗」嚟回答「喺 Claude 行」。
AGENT_RUNTIME=openai-agents
#
# 🔴 **冇 default,唔設就唔跑得**(plan OQ-1 仍然未答)。
#
# 揀邊個 model 同時決定咗三件事:幾錢、做唔做得到、**邊個第三方收到一個真人
# 嘅 request 原文**(plan OQ-7)。code 側一個 fallback 常數就等於幫人做咗
# 呢三個決定再收埋佢,所以未設就 503,唔會靜靜用一個猜返嚟嘅 model。
#
# 可以喺 Settings → Integrations 改(非機密,ADR-0013 Model C),DB 優先於 env。
AGENT_MODEL=
#
# ── 🔴🔴 Azure OpenAI —— inference 去邊(ADR-0037 E1)────────────────
#
# **平台只准打公司 tenant 嘅 Azure OpenAI,唔准打 `api.openai.com`。**
# 論據唔係「內容少咗」係「**收件人變咗**」:request 原文係一個真人寫嘅 email
# (有名有 UPN),而喺 Azure 之下佢只喺「公司 ↔ Microsoft」之間流動 —— 同平台
# 今日打緊嘅 Graph / M365 / Entra **完全同一個信任面**。
#
# 🔴 **2026-08-17 之前,呢條規矩由「冇人設個 key」執行,而嗰個係一個缺席唔係
# 一道閘** —— `@openai/agents` 預設就係打公開 API,一個 env var 就足以把原文
# 送出去,**冇 error、冇 log、冇嘢係紅嘅**。而諷刺位:Claude 嗰邊(今日冇人用)
# **一早就有**呢道閘兼有 test 守住(ADR-0038 D3)⇒ **弱嗰道閘企咗喺行人多嗰條路。**
# 而家 `buildAzureClient()` 三個值缺一就 503,兼且六條 test 守住(含一條 assert
# 個 client `baseURL` **唔含** `api.openai.com`)。
#
# ⚠️ **三個值全部冇 code-side default,而第三個嘅理由最唔明顯**:
#   ENDPOINT     —— 冇佢就係 E1 本身,拒絕,唔跌返去公開 API
#   API_KEY      —— H4:只落 env,唔入 DB / 唔入 API 回應 / 唔入 audit
#   API_VERSION  —— 佢決定個 deployment 講唔講 **Responses API**,而
#                   `@openai/agents` 用嘅就係佢。猜一個 default 會把「版本唔啱」
#                   變成一個**兩樣都唔提**嘅 404
#
# 📌 **`AGENT_MODEL` 喺 Azure 之下 = deployment name**(ADR-0037 E3)。client
# **刻意唔設 `deployment`** ⇒ Azure 由每個 request 個 `model` 攞,咁「真正會被
# 改嗰個值」就仍然喺 Settings → Integrations 改得到(ADR-0013 Model C)。
#
# 🔴 **`deployment` 呢個字係本段最高風險嘅一個詞** —— 對 infra 嚟講佢預設係
# **ARM deployment**。填錯 = **404**,而錯誤訊息**唔會提示**呢件事(RISK R17)。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
#
# ── Agent run expiry(W46 期二 G5 / plan OQ-5)────────────────
#
# 一個 proposal 冇人撳,run 就一直停喺 `awaiting_approval`。而 OQ-3 定咗
# **一張 request 同時只准一個非終態 run** ⇒ 冇人撳嗰張單就**永遠開唔到新 run**,
# 而平台冇任何自愈路。呢個 sweep 就係嗰條路。
#
# 🔴 門檻 = **7 日**(Chris 2026-08-16 拍板)。佢**唔係 SLA 係一道回收閘**:
# 太短會殺死「週末 + 一個假期」之後仍然有效嘅 proposal,太長就等於冇。
# `AgentProposal.decidedAt` 令真實分佈量得返(G7),所以將來收緊係有數據支持,
# 唔係再估一次。
#
# ⚠️ sweep **只掃 `awaiting_approval`,刻意唔掃 `running`** —— 一個 running 嘅 run
# 有 in-flight model call,由另一個 process 令佢過期就係平台自己講一件仲做緊嘅事
# 做完咗。要偵測真死咗嗰啲需要 heartbeat 唔係門檻,而喺一個應該誠實留白嘅位
# 塞一個錯答案更差。
#
# 三個都係 tuning knob(唔設有 sane default,唔會 fail boot)。
# ENABLED 預設**開**(`!== 'false'`)⇒ 唔記得設 = 照跑,只有明文 "false" 先停。
AGENT_RUN_EXPIRY_ENABLED=true
AGENT_RUN_EXPIRY_DAYS=7
AGENT_RUN_EXPIRY_BATCH=50
#
# ── 期二 G5-B + G6 / ADR-0039 —— agent run 背景執行 + SSE ──────────────
#
# 🔴🔴 **`REDIS_URL` 係本 phase 第二個 infra 依賴,而 DEV today 冇 Redis。**
# `POST /agent/runs` 而家只 enqueue 就返(F1),真嘢喺 in-process BullMQ worker
# 度做;而 SSE 亦都要佢 —— ACA 可以行多過一個 replica,worker 喺 A 而瀏覽器條
# SSE 連線可能落 B,所以 B 冇嘢 stream 得出去,除非兩者經 Redis(F4)。
# ⇒ **「唔用 BullMQ,`setImmediate` 背景跑」慳唔到 Redis**,只會多一個
# 「process 死咗 run 永遠 `running`」嘅缺口(而 expiry sweep 刻意唔掃 running)。
#
# ⚠️ **本機 `docker-compose.yml:23-32` 一直有 `uop-redis`(6379)** —— Redis +
# BullMQ 早就喺 §5.2 locked stack,只係由頭到尾冇 code 連過佢(所以本次唔觸發
# H2)。⇒ 本機唔使做嘢,卡住嘅淨係部署同 live 驗(同 A14 完全同一個形狀)。
#
# 🔴 **R23:Redis 冇 ≠ kill switch 閂咗。** enqueue 失敗會返一句明文講
# 「background queue (Redis) is unreachable … not the agent kill switch」——
# 因為 kill switch 係**有人故意撳**嘅嘢,而畫面唔可以令兩者讀落一樣。
REDIS_URL=redis://127.0.0.1:6379
#
# Worker 同時行幾多個 run。1 會令成個 deployment 排隊等最慢嗰個(而個等係
# 以分鐘計),大數字就係扮 event loop 係免費嘅(R24)。2 = 一個唔會塞死條隊
# 嘅地板,而個 knob 存在係為咗畀真環境嘅數字取代呢度嘅猜測。
AGENT_RUN_CONCURRENCY=2
#
# SSE heartbeat(毫秒)。⚠️ **R22 嘅緩解,唔係解決** —— 一條 idle SSE 連線
# 正正就係 buffering proxy 會捉住嗰種,periodic bytes 令佢繼續流兼避開 idle
# timeout。ACA ingress 到底 buffer 唔 buffer,**本機測唔到,只有 DEV 答到**(F7)。
AGENT_SSE_HEARTBEAT_MS=25000
#
# 🔴 SECRET ×2。永遠只落 env,絕不入 DB / API 回應 / audit(D10, H4)。
# 用邊個視乎 AGENT_RUNTIME;兩個都列出嚟,令 Integrations panel 兩邊都報得準。
OPENAI_API_KEY=
#
# 🔴🔴 **ANTHROPIC_API_KEY 今日唔應該填。**
#
# W46 `OQ-7`(把 `rawRequestText` 真人 email 原文送去邊個 model provider)
# **只答咗 OpenAI 嗰半** —— ADR-0037:行公司 tenant 嘅 Azure OpenAI。
# Anthropic **唔喺**公司個 M365 / Azure 信任面入面,而 ADR-0037 `E7` 明文寫住
# 真打之前要重新答一次,唔可以引用嗰份 ADR 當已答。
#
# ⇒ `ClaudeToolRunnerProvider` 存在係為咗證 **ADR-0036 D1**(一份 tool 定義
# 兩個 runtime),唔係為咗開一個新出口(ADR-0038 D3)。佢**明文讀呢個 env
# 再自己 check**,而唔係由 SDK 自己 fallback —— 因為 `new Anthropic()` 唔傳
# key 就會靜靜攞呢一行,咁樣「一個冇人覆核過嘅 env var」就會係平台同第三方
# 之間唯一嗰道嘢(同 ADR-0036 D11 tracing 同一個形狀)。
#
# **RISK R21** 講嘅就係呢件事:填咗佢 = 真打。
ANTHROPIC_API_KEY=
