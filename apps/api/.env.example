# Unified Operation Platform — env 範本
# Copy 做 .env 填實際值。.env 已 gitignore,絕不 commit 真實 secret(見 CLAUDE.md §5 H4)。

# ── Microsoft Graph (app-only / client credentials) ──────────
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret

# ── ServiceNow (Table API, basic-auth integration account) ───
SERVICENOW_INSTANCE_URL=https://ricoh.service-now.com
SERVICENOW_USER=svc-platform-integration
SERVICENOW_PASSWORD=your-password
# Align with the table Phase 1 already uses:
SERVICENOW_DEFAULT_TABLE=sc_req_item

# ── Database (Prisma) ────────────────────────────────────────
# 對齊 repo root docker-compose.yml(postgres user/pass/db = uop/uop/platform;host port 5433 避開既有 5432)
DATABASE_URL=postgresql://uop:uop@localhost:5433/platform

# ── n8n inbound intake (m2m, ADR-0008 Phase 甲) ──────────────
# Shared secret n8n sends as the X-Intake-Key header on POST /requests/intake.
# Fail-closed: unset → app boot fails (IntakeKeyGuard getOrThrow). Rotate per env.
INTAKE_API_KEY=change-me-intake-secret
