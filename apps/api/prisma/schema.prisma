// ─────────────────────────────────────────────────────────────
// Phase 2 Unified Platform — Domain Model (v1, finalised fields)
//
// Positioning : System of Action.  ServiceNow (System of Record)
//               fields are MIRROR / REFERENCE only — the platform
//               does not own intake, approval or SLA.
// Scope       : M365 + D365 license fulfilment (onboarding + standalone
//               request). D365 = Entra subscribedSku, same Graph
//               assignLicense (ADR-0008). No license change / offboarding.
// Reconcile   : Option (甲) manual ledger + SKU TOTAL-level drift.
// Out of scope (by design): license cost/invoice (DocuWare owns it),
//               per-user auto-attribution, D365-side provisioning
//               (security role / legal entity). See ADR-0008.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity & access (Entra SSO + local password → app roles) ─
// Dual-provider (ADR-0005): SSO users have entraOid; local users have
// passwordHash. email is the shared login identifier. authProvider disambiguates.

enum Role {
  ADMIN // platform admin
  REGIONAL // Regional IT — sees all OpCos
  OPCO_IT // OpCo IT — scoped to own OpCo (future self-service)
}

model AppUser {
  id                  String               @id @default(cuid())
  entraOid            String?              @unique // Entra object id (SSO users; null for local accounts)
  email               String               @unique // login identifier for both providers
  displayName         String
  passwordHash        String? // argon2id hash (local accounts; null for SSO) — NEVER serialised
  authProvider        String               @default("entra") // 'entra' | 'local'
  // Password lifecycle (ADR-0006 / AUTH-4c-A). Local accounts only.
  mustChangePassword  Boolean              @default(false) // force-change-on-first-login (set on admin create/reset)
  failedLoginCount    Int                  @default(0) // consecutive failed local logins → lockout
  lockedUntil         DateTime? // local login locked until this time (null = not locked)
  passwordChangedAt   DateTime? // last local password change (audit)
  role                Role                 @default(REGIONAL)
  opcoScopeId         String? // set for OPCO_IT; null = all (REGIONAL / ADMIN)
  opcoScope           Opco?                @relation(fields: [opcoScopeId], references: [id])
  active              Boolean              @default(true)
  lastLoginAt         DateTime? // ops visibility
  createdAt           DateTime             @default(now())
  handledRequests     Request[] // requests this operator is handling
  events              RequestEvent[]
  refreshTokens       RefreshToken[] // AUTH-4c-B rotating refresh sessions (local accounts)
  passwordResetTokens PasswordResetToken[] // AUTH-4c-C self-service reset (local accounts)
  ledgerAdjustments   LedgerAdjustment[] // ledger hand-edits made by this operator (ADR-0007)
  auditLogs           AuditLog[] // platform audit trail entries this operator caused (ADR-0009)
  agentRuns           AgentRun[] // AI-Assist runs started under this operator's OpCo scope (ADR-0036)
  agentConversations  AgentConversation[] // ADR-0041 D2 — chat threads this operator owns
}

// ── RefreshToken (AUTH-4c-B / ADR-0006 §7) — rotating refresh session for the
// local httpOnly-cookie session. Stores only the SHA-256 hash of the opaque
// token; rotation revokes the prior row. NEVER store the raw token (H4).

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the opaque refresh token
  expiresAt DateTime
  revokedAt DateTime? // set on rotation / logout (null = still valid)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── PasswordResetToken (AUTH-4c-C / ADR-0019 D8 #1) — single-use, 30-minute
// self-service password reset. Deliberately the SAME shape as RefreshToken
// above: opaque high-entropy token, only its SHA-256 hash persisted (H4), and
// cascade-deleted with the user. The difference is `usedAt` instead of
// `revokedAt` — a reset token is spent by being used exactly once, it is not
// rotated.
//
// 🔴 The raw token is returned to the caller ONCE, to be put in an email, and
// never stored. That is what makes a replay from the outbound failure queue
// impossible by construction (see REPLAYABLE_TEMPLATES in templates.ts).

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the opaque reset token
  expiresAt DateTime
  usedAt    DateTime? // set the moment it is spent (null = still usable)
  createdAt DateTime  @default(now()) // also drives the per-account cooldown

  @@index([userId])
}

// ── OpCo (company + optional cost-center; the 24 Excel columns)

model Opco {
  id          String          @id @default(cuid())
  code        String          @unique // e.g. "RAPO/IT", "RHK", "RTH"
  displayName String
  company     String // e.g. "RAPO", "RHK"
  costCenter  String? // e.g. "IT", "SCM"; null for company-level
  active      Boolean         @default(true)
  ledger      OpcoSkuLedger[]
  requests    Request[]
  scopedUsers AppUser[]
  createdAt   DateTime        @default(now())
}

// ── SKU catalog ──────────────────────────────────────────────
// skuId (GUID) is the ONLY primary truth. Seed from live tenant
// subscribedSkus; businessAlias maps the old (unreliable) Excel names.

model SkuCatalog {
  id            String              @id @default(cuid())
  skuId         String              @unique // M365/D365 GUID (subscribedSkus.skuId) — source of truth (ADR-0008 D5)
  skuPartNumber String // e.g. "SPE_E3", "ENTERPRISEPACK"
  displayName   String // human-friendly official name
  businessAlias String? // old Excel label — for mapping / reconciliation only
  category      String? // grouping for the OpCo asset-list view (e.g. "Base", "Add-on", "Power Platform", "Security")
  isBaseLicense Boolean             @default(false) // base bundle (E3/F3) vs add-on — UI default hint, NOT a hard gate
  // Does this SKU have a "how many seats did we buy" concept at all (ADR-0032 D1)?
  //   'prepaid'   = yes, prepaidEnabled is a real number (the default)
  //   'unlimited' = no, Graph expresses it with a sentinel (10000 / 50000 / 1000000 observed)
  // Human-curated like businessAlias / category (ADR-0004 curation-as-scope) —
  // tenant sync must never write it. String, not a Prisma enum, for the same
  // reason as ADR-0031 D1: an enum mints a second list to keep in step.
  seatModel     String              @default("prepaid")
  active        Boolean             @default(true)
  lastSyncedAt  DateTime? // last time this entry was confirmed against tenant subscribedSkus
  ledger        OpcoSkuLedger[]
  lineItems     RequestLineItem[]
  snapshots     TenantSkuSnapshot[]
  driftAlerts   DriftAlert[]
  createdAt     DateTime            @default(now())
}

// ── Per-OpCo per-SKU ledger (Option 甲: manual) ──────────────
// allocatedQuantity = OpCo budget / owned (the Excel cell, OpCo-managed) → display
// assignedQuantity  = actually assigned baseline → THIS reconciles vs tenant total (M365 + D365, ADR-0008 D5)

model OpcoSkuLedger {
  id                String             @id @default(cuid())
  opcoId            String
  opco              Opco               @relation(fields: [opcoId], references: [id])
  skuCatalogId      String
  sku               SkuCatalog         @relation(fields: [skuCatalogId], references: [id])
  allocatedQuantity Int                @default(0) // budget / owned (OpCo-managed)
  assignedQuantity  Int                @default(0) // baseline assigned (+1 on assign, OR manual correction — ADR-0007)
  updatedAt         DateTime           @updatedAt
  adjustments       LedgerAdjustment[] // hand-edit audit trail (ADR-0007 / W23-A)

  @@unique([opcoId, skuCatalogId])
}

// ── Ledger manual-adjustment audit (ADR-0007 / W23-A) ────────
// One row per hand-edited ledger FIELD (allocatedQuantity / assignedQuantity)
// via PATCH /license/ledger/:id. import (W13) + assign (W04) do NOT write here —
// they keep their own audit (import summary / RequestEvent). Only per-cell manual
// edits land here. H4: actor is an AppUser id, never PII (no email / UPN).

model LedgerAdjustment {
  id          String        @id @default(cuid())
  ledgerId    String
  ledger      OpcoSkuLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  field       String // 'allocatedQuantity' | 'assignedQuantity'
  beforeValue Int
  afterValue  Int
  reason      String?
  actorId     String?
  actor       AppUser?      @relation(fields: [actorId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([ledgerId, createdAt])
}

// ── Live M365 tenant state (from subscribedSkus) — total truth

// ADR-0033 D1 — all four prepaidUnits buckets are stored, not just `enabled`.
// `prepaidEnabled` keeps its name on purpose: it always did mean exactly
// prepaidUnits.enabled. What was wrong was treating it as the whole of `owned`.
model TenantSkuSnapshot {
  id               String     @id @default(cuid())
  skuCatalogId     String
  sku              SkuCatalog @relation(fields: [skuCatalogId], references: [id])
  prepaidEnabled   Int // prepaidUnits.enabled   — assignable now
  suspendedUnits   Int        @default(0) // prepaidUnits.suspended — subscription cancelled
  warningUnits     Int        @default(0) // prepaidUnits.warning   — expired, in grace period
  lockedOutUnits   Int        @default(0) // prepaidUnits.lockedOut — locked, unusable
  consumedUnits    Int // consumedUnits (total assigned in tenant)
  // Microsoft's own verdict on the subscription. Stored rather than derived from
  // the four numbers above: deriving it would re-create a judgement the vendor
  // already published (the ADR-0004 / ADR-0032 shape).
  capabilityStatus String     @default("Enabled") // Enabled | Warning | Suspended | Deleted | LockedOut
  capturedAt       DateTime   @default(now())

  @@index([skuCatalogId, capturedAt])
}

// ── Drift detection — reconciliation at SKU TOTAL level only ──
// sum(all OpCo assignedQuantity) vs M365 tenant consumedUnits

enum DriftStatus {
  OPEN
  RESOLVED
}

model DriftAlert {
  id                String      @id @default(cuid())
  skuCatalogId      String
  sku               SkuCatalog  @relation(fields: [skuCatalogId], references: [id])
  ledgerAssignedSum Int // sum of assignedQuantity across OpCos
  tenantConsumed    Int // tenant consumedUnits at detection (M365 + D365, ADR-0008 D5)
  delta             Int // tenantConsumed - ledgerAssignedSum
  status            DriftStatus @default(OPEN)
  note              String?
  detectedAt        DateTime    @default(now())
  resolvedAt        DateTime?
}

// ── Onboarding license request (consumes a ServiceNow ticket) ─

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Request {
  id                String        @id @default(cuid())
  serviceNowSysId   String?       @unique // parent REQ (sc_request) sysId — two-level (ADR-0008); per-line RITM lives on RequestLineItem
  serviceNowNumber  String? // e.g. REQ0012345 (parent REQ)
  serviceNowStatus  String? // mirrored for display, not owned
  rawRequestText    String? // free-text remark → source for human / future-AI interpretation
  origin            String        @default("onboarding-intake") // 'onboarding-intake' (W03/n8n) | 'platform-created' (Phase 乙 outbound) — ADR-0008 D6
  requesterEmail    String? // who filed the ticket (may differ from the new user)
  targetUpn         String // the new user being onboarded
  targetDisplayName String?
  opcoId            String
  opco              Opco          @relation(fields: [opcoId], references: [id])
  status            RequestStatus @default(OPEN)
  handledById       String? // Regional operator owning this request
  handledBy         AppUser?      @relation(fields: [handledById], references: [id])

  // Phase 1 (n8n) linkage — assign is GATED on azureSyncedAt
  accountCreatedAt DateTime?
  azureSyncedAt    DateTime?

  // ── ADR-0025 D4: gate ② — the SERVICENOW half of "is this person real yet" ──
  //
  // Two gates, not one, because they answer different questions and open at
  // different times: Azure says the licence CAN be assigned (Graph can find the
  // user); ServiceNow says the licence request is OPERABLE (the RITM's
  // target_user can point at a real person instead of the requester placeholder).
  //
  // `serviceNowUserSysId` is not bookkeeping — it is what the sweep backfills
  // into the RITM's `target_user` variable the moment the gate opens (D3), so
  // the request stops naming the requester as its own target.
  serviceNowUserSyncedAt DateTime?
  serviceNowUserSysId    String? // sys_user sys_id of the target, once SN has them

  // ── ADR-0035: the licence REQ **this platform** raised ──────────────────
  //
  // 🔴 NOT the same ticket as `serviceNowNumber` above, and the difference is
  // the whole reason this column needed an ADR:
  //   serviceNowNumber → the ONBOARDING REQ n8n raised. @unique, and this
  //                      row's idempotency key, so it can never change.
  //   this             → the O365 User License Maintenance Request the
  //                      PLATFORM raised for this joiner (ADR-0025 D2). Its
  //                      RITMs live on RequestLineItem.serviceNowNumber.
  //
  // 🔴 Deliberately NOT @unique, and deliberately never used in a `where` /
  // `upsert` / `findUnique` clause. That restriction IS the decision: the
  // original objection recorded below ("two candidate idempotency keys") is
  // about a second KEY, not a second reference — a column that cannot be
  // looked up cannot become one. Putting this in a lookup re-opens exactly
  // the problem ADR-0035 argued its way around.
  //
  // Written once, in the same transaction as the RITMs (intake-adapter); null
  // on every row raised before ADR-0035 and on every failed submission.
  serviceNowLicenceReqNumber String?

  lineItems          RequestLineItem[]
  events             RequestEvent[]
  outboundFailures   OutboundFailure[] // ADR-0011 — null for submit failures (no Request exists yet)
  agentRuns          AgentRun[] // ADR-0036 — AI-Assist runs reasoning about this request
  // ADR-0041 D2 — chat threads that OPTED IN to this request as context. A
  // conversation is not owned by a request and does not end when it closes.
  agentConversations AgentConversation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?

  @@index([opcoId, status])
}

// ── Per-SKU line item ────────────────────────────────────────
// The fulfilment STAGE lives HERE, not on the request, because one
// request can have SKUs at different stages
// (E3 available → assign now; Copilot → still in procurement).

enum LineItemStage {
  REQUESTED // interpreted from the request
  QUOTING // procurement: getting vendor quote
  OPCO_APPROVED // procurement: OpCo approved the spend
  AWAITING_VENDOR // procurement: PO sent, waiting for provisioning
  READY // procured OR already available — ready to assign (may wait for sync)
  ASSIGNED // license assigned in M365
  CANCELLED
}

model RequestLineItem {
  id                  String        @id @default(cuid())
  requestId           String
  request             Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  skuCatalogId        String
  sku                 SkuCatalog    @relation(fields: [skuCatalogId], references: [id])
  quantity            Int           @default(1)
  procurementRequired Boolean       @default(false) // set at triage: false = short path, true = procurement path
  stage               LineItemStage @default(REQUESTED)

  // ServiceNow sc_req_item (RITM) — two-level linkage (ADR-0008 D6 / CONTRACT §4).
  // Request.serviceNow* = parent REQ (sc_request); these = THIS line's RITM.
  //
  // 🔴 ADR-0025 OQ-2 — on an onboarding these two now point at DIFFERENT
  // ServiceNow requests, and mixing them up is the easiest mistake to make here:
  //   Request.serviceNow*  = the ONBOARDING REQ n8n raised (and the @unique
  //                          idempotency key — it must never change)
  //   these fields         = the O365 User License Maintenance Request the
  //                          PLATFORM raised for this line, and the one it
  //                          closes after assigning.
  // The platform's own REQ deliberately has nowhere on `Request` to live: giving
  // it one would mean two candidate idempotency keys for the same row.
  // Nullable: legacy rows + user-facing intake without a per-line RITM.
  serviceNowSysId  String?
  serviceNowNumber String?

  // TRACEABILITY ONLY (ADR-0025 D1) — the Windows Domain Account sc_task that
  // n8n workflow 1001 handled for this line, handed over at intake.
  //
  // 🔴 These do NOT drive the close path, despite what CH-020 / ADR-0024 D1
  // originally said. That design rested on the workflow JSON's own comments
  // ("Phase 2 closes ONLY the WDA task, and only once the E5 licence is
  // assigned"), which were disproved against the live instance on 2026-08-03:
  // n8n closes that task itself (close_notes = 'Closed & Handled by n8n'), and
  // the note-only branch the JSON describes has never run. Acting on these
  // columns meant PATCHing an already-closed task on every assign.
  //
  // Kept rather than dropped: a nullable column costs nothing, a drop migration
  // against a deployed UAT does not, and knowing which task n8n handled is
  // genuinely useful when reconciling an onboarding by hand.
  serviceNowTaskSysId  String?
  serviceNowTaskNumber String?

  // procurement references (recorded during manual stage tracking)
  quoteRef String? // vendor quotation reference
  poRef    String? // purchase order reference

  // W40 / ADR-0017 D3 — when the platform last told ServiceNow this line's RITM
  // is on hold (budget gate blocked it, "procurement in progress"). Set only on
  // the transition, never on every blocked attempt: an operator can retry a
  // blocked assign as often as they like, and each retry must not PATCH a real
  // customer ticket again.
  ticketHeldAt DateTime?

  // stage timestamps (procurement path)
  quotedAt        DateTime?
  opcoApprovedAt  DateTime?
  vendorOrderedAt DateTime?
  readyAt         DateTime?
  assignedAt      DateTime?

  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    RequestEvent[]

  @@index([requestId])
  @@index([stage])
}

// ── Operational history (platform-owned; NOT the ServiceNow audit)

enum EventType {
  STAGE_CHANGE
  ASSIGN
  SYNC
  RECONCILE
  NOTE
}

model RequestEvent {
  id         String           @id @default(cuid())
  requestId  String
  request    Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineItemId String?
  lineItem   RequestLineItem? @relation(fields: [lineItemId], references: [id])
  type       EventType
  fromStage  LineItemStage?
  toStage    LineItemStage?
  message    String?
  actorId    String?
  actor      AppUser?         @relation(fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([requestId, createdAt])
  // CH-006: the Overview feed pulls the newest events ACROSS requests, which the
  // composite above cannot serve (its leading column is requestId). Additive and
  // reversible — approved as H1-lite rather than via ADR (spec.md §1.1).
  @@index([createdAt])
}

// ── Platform audit trail (ADR-0009) ──────────────────────────
// Covers every write the two domain-specific records do NOT. RequestEvent owns
// request lifecycle; LedgerAdjustment owns per-cell ledger edits — both stay
// untouched (Decision 1: coexist, never replace). What lands here: user CRUD /
// role changes / password resets, login outcomes, OpCo + catalog curation,
// allocation import, drift resolution.
//
// H4 (Decision 5): `before`/`after` carry WHITELISTED fields only — see
// audit-fields.ts. passwordHash / tokenHash are permanently blacklisted, and
// `metadata` is key-restricted too so it cannot become an escape hatch around
// the whitelist.
//
// Decision 8.1: written inside the CALLER's $transaction. A failed operation
// leaves no audit row, and a failed audit fails the operation — deliberate:
// "done but unrecorded" is worse than "not done".
//
// PII (Decision 7, option P-B): actorId/targetId are ids, but whitelisted
// before/after MAY contain email / displayName because those are precisely the
// thing being changed. Consequence: read access stays ADMIN-only, and any
// future retention policy must cover this table.

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // AppUser id; null = system / cron / m2m
  actor      AppUser? @relation(fields: [actorId], references: [id])
  actorType  String   @default("user") // 'user' | 'system' | 'm2m' | 'agent' (ADR-0036 D7)
  action     String // 'user.role_change' | 'opco.update' | … (AUDIT_ACTIONS)
  targetType String // 'AppUser' | 'Opco' | 'SkuCatalog' | …
  targetId   String
  before     Json? // whitelisted fields only
  after      Json? // whitelisted fields only
  metadata   Json? // restricted key set only
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ── Outbound delivery failures (ADR-0011) ────────────────────
// Outbound used to fail and vanish: a throw, a logger.warn, nothing queryable.
// This table makes each failure a visible, retryable fact.
//
// THREE kinds, and they are NOT interchangeable (Decision 2) — the whole point
// of the `kind` column is that each needs a DIFFERENT repair:
//   request.submit     → SN/n8n ticket creation failed; nothing written locally
//                        (clean) → repair = submit again.
//   request.mirror     → the ticket EXISTS in ServiceNow but the local mirror
//                        write failed (orphan) → repair = write the local rows
//                        from `externalRef`. 🔴 NEVER re-submit: that opens a
//                        SECOND real ticket (Decision 3).
//   servicenow.worknote → assign succeeded, the write-back note did not. It is
//                        swallowed by design (OD4) → repair = send it again.
//
// H4 (Decision 5): `payload` / `externalRef` are WHITELISTED per kind — see
// outbound-failure-fields.ts. Credentials and raw vendor bodies never land
// here; `lastError` holds the message text only.
//
// Decision 6 — deliberately the OPPOSITE of AuditLog above: this row is written
// OUTSIDE the caller's transaction. request.mirror's failure IS a failed local
// write, so joining that transaction would roll the record away at exactly the
// moment it is needed.
//
// Unlike AuditLog, this table is STATEFUL (status / attemptCount get updated) —
// which is why the audit trail was not reused as a work queue (Decision 9).
// PII: payload carries targetUpn. Read + repair is ADMIN + REGIONAL (Decision
// 4) — the same people who already see these requests. No opcoId column: scope
// derives via requestId → Request.opcoId if ever needed.

model OutboundFailure {
  id     String @id @default(cuid())
  kind   String // 'request.submit' | 'request.mirror' | 'servicenow.worknote'
  status String @default("open") // 'open' | 'resolved' | 'abandoned'

  payload     Json // whitelisted inputs needed to redo the thing
  externalRef Json? // side-effects that ALREADY happened (mirror: the SN sysIds)

  lastError     String // message text only — never the raw vendor body
  attemptCount  Int      @default(1)
  lastAttemptAt DateTime @default(now())

  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String? // AppUser id; who repaired or abandoned it

  @@index([status, createdAt])
  @@index([kind, status])
}

// ── Connector configuration (ADR-0013 / Model C) ──────────────
// Non-secret connector settings an ADMIN can edit in the UI. ONE ROW PER
// connector; any null column falls back to the env value (resolver =
// DB-then-env, ConnectorConfigService). REAL SECRETS ARE NEVER STORED HERE
// (H4) — GRAPH_CLIENT_SECRET, SERVICENOW_USER/PASSWORD, N8N_OUTBOUND_WEBHOOK_KEY,
// INTAKE_API_KEY stay in env only. Changes apply on next app boot (C2, ADR-0013
// D4). "Who changed what" is answered by AuditLog (ADR-0009) — no updatedById here.
model ConnectorConfig {
  id        String @id @default(cuid())
  connector String @unique // 'graph' | 'servicenow' | 'n8n-outbound' | 'n8n-license'

  // Graph — non-secret only (GRAPH_CLIENT_SECRET stays in env)
  graphTenantId String? // GRAPH_TENANT_ID override
  graphClientId String? // GRAPH_CLIENT_ID override

  // ServiceNow — non-secret only (SERVICENOW_USER/PASSWORD stay in env)
  serviceNowInstanceUrl  String? // SERVICENOW_INSTANCE_URL override
  serviceNowDefaultTable String? // SERVICENOW_DEFAULT_TABLE override

  // n8n outbound — non-secret only (N8N_OUTBOUND_WEBHOOK_KEY stays in env)
  requestSubmissionProvider String? // REQUEST_SUBMISSION_PROVIDER override ('direct' | 'n8n')
  n8nOutboundWebhookUrl     String? // N8N_OUTBOUND_WEBHOOK_URL override

  // n8n license ops (W39 / ADR-0017 seam ②) — non-secret only.
  // The x-uop-secret shared key stays in env as N8N_LICENSE_WEBHOOK_KEY: it is
  // the one credential that lets anyone assign licences through n8n, so it must
  // never reach a DB column, an API response or an audit row (ADR-0013 D2).
  licenseOpsProvider String? // LICENSE_OPS_PROVIDER override ('graph' | 'n8n')
  n8nLicenseBaseUrl  String? // N8N_LICENSE_BASE_URL override (webhook base, no trailing path)

  // n8n ticket updates (W40 / ADR-0017 seam ④) — non-secret only.
  // N8N_TICKET_WEBHOOK_KEY stays in env for the same reason as the license key:
  // it is what lets a caller change the state of a customer's ticket.
  ticketUpdateProvider String? // TICKET_UPDATE_PROVIDER override ('direct' | 'n8n')
  n8nTicketWebhookUrl  String? // N8N_TICKET_WEBHOOK_URL override (webhook base, no trailing path)

  // Email / ACS (CH-011 / ADR-0019 D4) — non-secret only.
  // ACS_CONNECTION_STRING carries the access key and stays in env, same rule as
  // every other credential above. Adding this column is the ALTER TABLE that
  // ADR-0013's W39 note predicted: ConnectorConfig is named columns, not a
  // key-value bag, so a new connector always costs a migration.
  acsSenderAddress String? // ACS_SENDER_ADDRESS override (e.g. no-reply@example.com)

  // n8n inbound intake (W42 / ADR-0020 D4) — non-secret. The first editable
  // field this connector has ever had; INTAKE_API_KEY stays in env.
  //
  // 🔴 A skuId GUID, never a name. The catalogue already carries two E5
  // variants (SPE_E5 and Microsoft_365_E5_(no_Teams)), so "the E5 one" is not
  // an identifier — and picking the wrong one puts the wrong product on a real
  // person's account. Validated on write against an active SkuCatalog row
  // (kind 'sku'), because this connector cannot be probed: a write-time
  // rejection is the only feedback an operator ever gets.
  defaultOnboardingSkuId String? // DEFAULT_ONBOARDING_SKU_ID override

  // W46 / ADR-0036 D10 — the agent runtime seam. Non-secret only: both API keys
  // (OPENAI_API_KEY / ANTHROPIC_API_KEY) stay in env forever, same rule as every
  // credential above.
  //
  // 🔴 agentModel has NO default in code. Which model an agent runs on is a cost,
  // capability and data-processing decision (plan OQ-1 / OQ-7), and a hard-coded
  // fallback would make that decision silently on somebody's behalf — so an
  // unset value fails loudly instead.
  agentRuntime String? // AGENT_RUNTIME override ('openai-agents' | 'claude-tool-runner')
  agentModel   String? // AGENT_MODEL override

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── AI agent runtime (W46 / ADR-0036) ────────────────────────
//
// D0 — an agent is a new EXECUTOR, not a new decision-maker. Every real
// side-effect still runs the platform's existing path (an approved assign keeps
// all eight gates). Nothing an agent can reach writes outside these five tables.
//
// The split between AgentStep and AgentMessage IS the decision (D4), not
// bookkeeping: one is what the platform DID, the other is what the agent SAID,
// and they carry different authority. INC-001 is this project's own proof of
// why — an Edit that was fabricated as success and never applied is
// indistinguishable from a real one if the only record is the narrator's.

// D7 — deliberately NOT an AppUser row with a Role. Role has three values, and
// giving an agent any of them grants that role's FULL power while
// derivePermissions() keeps reporting it as an ordinary user: silent privilege
// escalation with a matrix that says nothing is wrong.
model AgentPrincipal {
  id        String         @id @default(cuid())
  // The capability, not the model behind it ('ai-assist'). Which LLM answers is
  // runtime config (ConnectorConfig, ADR-0013 Model C); baking it in here would
  // make "who did this" change on every model upgrade.
  name      String         @unique
  runtime   String // 'openai-agents' | 'claude-tool-runner'
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  runs      AgentRun[]
  profiles  AgentProfile[]
}

/// 🔴 W47 F1 / Tier 2 `OQ-1` — 「多個 agent」係**同一套能力、唔同 model / prompt**.
///
/// Why a second model rather than columns on AgentPrincipal: the comment above
/// says `name` is the capability, NOT the model, because audit attribution must
/// not change every time a model is upgraded. This table keeps both facts and
/// lets them move independently — "who did this" is the principal, "what ran"
/// is the profile. An upgrade adds a profile; the principal never moves.
///
/// 🔴 It also dissolves a question that Option A would have forced: "is a model
/// upgrade a NEW agent or an EDIT to the existing one?" Both answers cost
/// something (editing loses what old runs actually ran on; creating grows the
/// agent list on every upgrade). Here it is neither — it is a new profile.
model AgentProfile {
  id          String         @id @default(cuid())
  principalId String
  principal   AgentPrincipal @relation(fields: [principalId], references: [id])

  /// Human-facing, e.g. 'ai-assist (gpt-4o)'. Unique PER PRINCIPAL rather than
  /// globally: two principals may each want a profile called 'default', and
  /// making that collide would be an accident of naming, not a real conflict.
  name String

  /// The Azure DEPLOYMENT name, not a model family — ADR-0037 E3 settled that
  /// `AGENT_MODEL` under Azure is a deployment name, so what is stored here is
  /// a deployment fact.
  model String

  /// null = use the default prompt that lives in code.
  ///
  /// 🔴 W47 R1 — this is the ONE column in this phase that hands behaviour to
  /// runtime configuration. Editing it changes how the agent reasons, and that
  /// change appears in no code review. Three defences, in order:
  ///   1. every edit is audited (OQ-C, following ADR-0013's ConnectorConfig)
  ///   2. the tool allow-list stays in CODE (ADR-0036 D1) — so the worst case
  ///      is an agent that talks nonsense, never one that does something it was
  ///      not permitted to do
  ///   3. this comment, so the next person adding a runtime-editable behaviour
  ///      column has to decide to do it rather than drift into it
  prompt String?

  /// Deactivated, never deleted. Historical runs point here to say what they
  /// ran on, and that answer must survive someone tidying up the list.
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  runs          AgentRun[]
  conversations AgentConversation[] // ADR-0041 D1 — a chat picks a profile too

  @@unique([principalId, name])
}

/// 🔴 W48 F2 / ADR-0041 — a CHAT THREAD. Deliberately NOT AgentMessage.
///
/// AgentMessage is bound to one runId and is a run transcript; ADR-0036 D6 keeps
/// it FOREVER, and that sentence was written about run transcripts. Relaxing it
/// (conversationId + nullable runId) reads as one migration and is actually a
/// widening of an accepted decision onto data with different PII, volume and
/// lifecycle — with no test anywhere that would go red. So: a second pair of
/// tables, and AgentMessage untouched.
///
/// A run is one task; a conversation is one relationship. Both may coexist —
/// a chat can start runs (see AgentRun.conversationId) — but neither
/// impersonates the other.
model AgentConversation {
  id String @id @default(cuid())

  /// 🔴 D2 — required, and the reason is the same one AgentRun.startedById
  /// gives: every tool call in this thread is bound to THIS person's OpCo
  /// scope (Tier 2 OQ-2, "an agent's scope can never exceed its starter's").
  /// Nullable would make "no owner" reachable, and no scope reads as every
  /// scope.
  startedById String
  startedBy   AppUser @relation(fields: [startedById], references: [id])

  /// 🔴 D3 — OPTIONAL CONTEXT, NOT AN OWNER. Two consequences, and the second
  /// is a security boundary rather than a UX choice:
  ///   1. the thread does not end when the request closes, and pointing it at a
  ///      different request does not make it a different thread
  ///   2. when this is null, request-scoped tools get NO request id — they
  ///      cannot answer, rather than answering and being told not to show it.
  ///      "Cannot see it" beats "told not to use it" by an order of magnitude
  ///      (ADR-0036 D2), and a falsification test pins it.
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])

  /// Which profile answers in this thread (W47 registry). Restrict, for the
  /// reason spelled out on AgentRun.profileId: SetNull would turn "this thread
  /// ran on the 4.1-mini profile" into "unknown" for every thread at once,
  /// without an error.
  profileId String?
  profile   AgentProfile? @relation(fields: [profileId], references: [id], onDelete: Restrict)

  /// 🔴 D7 — soft archive. There is no hard delete and no automatic retention:
  /// a conversation lives until someone archives it, and archiving hides it
  /// rather than removing it (same answer ADR-0040 gave for AgentRun one day
  /// earlier, so the platform does not hold two opposite positions on two
  /// neighbouring models).
  ///
  /// 🔴 This is NOT AgentRun.hiddenAt and the two must never be merged: an
  /// archived conversation can contain a run that was never hidden, and that
  /// run still belongs in the global run list.
  ///
  /// ⚠️ Known, accepted gap (ADR-0041 Consequences): GDPR-style true erasure
  /// still has no answer here. "Until cleared" means "until hidden".
  archivedAt DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  turns     AgentChatTurn[]
  runs      AgentRun[] // D4

  @@index([startedById, updatedAt])
  @@index([requestId])
}

/// One line of the dialogue.
///
/// 🔴 Named `AgentChatTurn`, not `AgentTurn` as ADR-0041 D1 wrote it (errata,
/// Chris 2026-08-18). `AgentTurn` was already taken, in this same module, by
/// `agent-runtime.provider.ts` — the seam's normalised result of ONE runtime
/// round-trip, which ADR-0017 D2 calls the core design work of a seam. Two
/// unrelated meanings under one name, in the one service (F3) that needs both,
/// is the kind of difference that holds only as long as someone remembers it.
///
/// `user` and `assistant` only — thinking and tool
/// traffic stay in AgentStep (the platform-written action ledger) and
/// AgentMessage (the run transcript), because an agent narrating "I did X" is a
/// claim, not evidence (INC-001), and this table is the part a person reads.
///
/// 🔴 content is scrubPii()'d before it lands — same rule as AgentMessage.content
/// and AgentStep.detail. With D7 there is no deletion path, so that scrub is the
/// only line of defence, exactly as it is for AgentMessage.
///
/// ⚠️ onDelete asymmetry, deliberate: turns Cascade (following AgentStep /
/// AgentMessage / AgentProposal), while AgentRun.conversationId is Restrict.
/// Net effect of a DELETE straight against the database: a conversation that
/// started a run is refused; one that never did takes its turns with it. There
/// is no endpoint for either (D7) — this is what the database does if someone
/// goes around it.
model AgentChatTurn {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model AgentRun {
  id          String         @id @default(cuid())
  principalId String
  principal   AgentPrincipal @relation(fields: [principalId], references: [id])

  // 🔴 The human whose OpCo scope every tool call in this run is bound to
  // (F1-6, Chris 2026-08-15). Required, and a relation, for one reason: an
  // approval can land overnight, and the run resuming then can only recover
  // that scope from this row. Nullable would make "no scope" a reachable
  // state — and no scope reads as every scope, which is the fail-open shape
  // ADR-0036 D0 exists to keep out of the agent path.
  startedById String
  startedBy   AppUser @relation(fields: [startedById], references: [id])

  /// Which profile this run actually used (W47 F3).
  ///
  /// 🔴 Nullable, and it stays nullable: runs started before W47 had no profile,
  /// and back-filling one would assert a fact that never happened. The screen
  /// shows those as "(before W47)" rather than hiding them (OQ-D) — hiding would
  /// turn "how many runs predate the registry" into an unanswerable question,
  /// and that is exactly the number a new list is easiest to be wrong about.
  ///
  /// 🔴 `onDelete: Restrict` is deliberate and is the DB half of `F2-3` (no
  /// DELETE endpoint). Prisma's default for an optional relation is SetNull,
  /// which would mean a delete run straight against the database quietly turns
  /// "this run used the 4.1-mini profile" into "unknown" for every historical
  /// run at once — the exact answer F2-3 exists to protect, lost without an
  /// error. Restrict makes the database refuse instead, so anyone who later
  /// wants deletion has to decide what happens to the history first rather
  /// than discovering it afterwards.
  profileId String?
  profile   AgentProfile? @relation(fields: [profileId], references: [id], onDelete: Restrict)

  /// 🔴 W48 F2 / ADR-0041 D4 — the conversation this run was started from, if
  /// any. A real foreign key rather than a loose column, for the reason stated
  /// on requestId below: "one table pointing at another without a key is a
  /// difference that holds only as long as someone remembers it". It turns
  /// "which sentence produced this proposal" into a question with an answer.
  ///
  /// Nullable and staying that way: every run before W48, and every run started
  /// from a request page rather than a chat, legitimately has no conversation.
  ///
  /// Restrict, not Prisma's SetNull default — the same argument as profileId
  /// above, and W47 F1-3 hit it first: SetNull means a delete run straight
  /// against the database quietly turns "this run came from that thread" into
  /// "unknown", with no error to notice.
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  // The request an AI-Assist run is reasoning about. Carries a foreign key,
  // the same shape as OutboundFailure.requestId (F1-7, Chris 2026-08-15).
  // plan §4 specified the column plus @@index and no relation; one table
  // pointing at Request without a key is a difference that holds only as long
  // as someone remembers it, so it was settled rather than written down.
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])

  // running | awaiting_approval | approved | rejected | completed | failed |
  // aborted | expired
  //
  // 🔴 `expired` (期二 G5 / plan OQ-5) is NOT a flavour of `aborted`. `aborted`
  // means the platform cleared this up on someone's instruction; `expired`
  // means nobody decided in time. G7's population (`decidedAt != null`) is
  // built on that distinction — merging them would blend "nobody reviewed
  // this" into "the platform stopped it", and the first is precisely what R13
  // measures. Adding a value costs no migration, which is ADR-0031 D1's
  // String-not-enum decision paying off.
  // String rather than a Prisma enum for ADR-0031 D1's reason: an enum mints a
  // second list to keep in step with this one.
  status String

  // 🔴 The SDK's resumable run state, stored ONLY so an approved proposal can
  // resume the SAME run (D3) — the agent then sees the outcome and keeps
  // reasoning, instead of the platform executing something behind its back.
  //
  // It is NOT the audit truth; AgentStep and AgentProposal are. R16: this is an
  // SDK-internal shape, so an upgrade can make an old awaiting_approval run
  // un-resumable. That must fail loudly — never quietly report success.
  runState Json?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // 🔴 CH-031 / ADR-0040 — set when an admin takes this run out of the day-to-day
  // workflow. It is NOT a delete, and the difference is the whole decision.
  //
  // Deleting the row would cascade AgentStep, AgentMessage and AgentProposal
  // away (see their onDelete below), i.e. the audit truth plus "who approved
  // what" — and ADR-0036 D6 keeps AgentMessage forever. ADR-0022 D1 hit the
  // identical shape on OpcoSkuLedger and answered it the same way: same effect,
  // one-sided cost, so keep the row and hide it at the read layer.
  //
  // 🔴 Deliberately NOT read by review-stats or the kill switch. Those aggregate
  // AgentProposal.decidedAt and AgentRun.status, which are orthogonal to this
  // column — so R13's rubber-stamp metric cannot be moved by hiding a run. That
  // is a structural property, not a habit, and `review-stats.service.ts` has a
  // falsification test pinning it (CH-031 C3).
  hiddenAt DateTime?

  steps     AgentStep[]
  messages  AgentMessage[]
  proposals AgentProposal[]

  @@index([status, startedAt])
  @@index([requestId])
  // W47 F4 — the run list filters by profile, and without this that filter is a
  // sequential scan that only shows up once there are enough runs to matter.
  @@index([profileId])
  // W48 F2 — a conversation lists the runs it started; same reason as above.
  @@index([conversationId])
}

// 🟢 The action ledger — written by the PLATFORM, around a tool actually
// running. This is the audit truth.
//
// Shape deliberately copied from AssignStep (assign-step.ts), including the
// rule that `skipped` is NOT a flavour of `ok`: "we did not need to do this"
// and "we did this and it worked" are different facts, and collapsing them is
// how a step nobody ran ends up reading as a step that succeeded. Reusing the
// shape also means AssignResultDialog's way of reading it carries straight over
// (ADR-0029: the keys are the contract).
model AgentStep {
  id    String   @id @default(cuid())
  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  key       String // tool name | 'gate' | 'proposal'
  status    String // ok | failed | skipped
  detail    String? // 🔴 scrubPii() before it lands — same rule as AssignStep.detail
  retryable Boolean? // only meaningful on `failed`
  whoFixes  String? // only meaningful on `failed` — see ASSIGN_STEP_OWNERS
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// ⚠️ The transcript — what the agent SAID (thinking / dialogue / tool intent).
// LOW authority BY DESIGN: an agent claiming "I did X" is a narrative, not
// evidence (INC-001). Never read this table to establish what happened; read
// AgentStep. It is here to understand, debug, assign responsibility and improve
// prompts — all of which need the claim, none of which need it to be trusted.
//
// 🔴 content is scrubPii()'d before it lands (D6). Retention is FOREVER and
// read access is ADMIN-only (Chris 2026-08-15) — and "forever" is exactly what
// promotes that scrub from a good habit into the only line of defence. It also
// makes the retention debt recorded at AuditLog above come due for real: this
// table is far larger than that one.
model AgentMessage {
  id    String   @id @default(cuid())
  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  role      String // user | assistant | thinking | tool_call | tool_result
  content   String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// The things a human has to press. A write tool never executes on its own: the
// SDK pauses on needsApproval, and the PLATFORM turns each pending interruption
// into one of these rows (D3). approvedById / rejectedReason live here rather
// than in the SDK's own approval state because "who approved what" is the only
// reason Tier 1 exists, and an in-memory object has no actor, no time, no audit
// and never appears on an admin screen.
//
// 🔴 Approving is not bypassing. An approved propose_assign still runs
// AssignService's eight gates and can still be refused by budget. That is
// correct — approval answers "should we do this", not "skip the checks" — and
// counter-intuitive enough that the UI has to say so (W46 F8).
model AgentProposal {
  id    String   @id @default(cuid())
  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  kind String // 'line_items' | 'assign'

  // The SDK-side interruption this row stands for. Resuming approves them one
  // by one (D3 step 4), so the mapping has to survive the round-trip through
  // the platform's own approval UI.
  interruptionRef String?

  // 🔴 skuId GUIDs only, never SKU names (plan §3.4 / R15). The catalogue
  // carries two E5 variants, so "the E5 one" is not an identifier — and an LLM
  // is exactly the kind of caller that will produce one anyway.
  payload Json

  status         String    @default("pending") // pending | approved | rejected | executed | failed
  approvedById   String? // AppUser id — same shape as OutboundFailure.resolvedById
  rejectedReason String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}
